# 导入pandas模块，简写为pd
import pandas as pd

# 读取文件，赋值给df
df = pd.read_csv(r"D:\tools\Programming\VSCODE\python_vscode\Files_RequiredforPractice\cross_border_ecommerce_platform_user_data\user_info\user_info\user_info.csv")

# 将"last_order_date"这一列，转为时间类型
df["last_order_date"] = pd.to_datetime(df["last_order_date"])

# 输出df
#print(df)

# 1.2 获取描绘R的数据
# 导入datetime模块中的datetime
from datetime import datetime

# 使用datetime()函数，构建2019年4月1日的时间，赋值给endTime
endTime = datetime(2019,4,1)

# 计算endTime和"last_order_date"这一列的时间间隔
# 将结果添加为df的"time_gap"列
df["time_gap"] = endTime - df["last_order_date"]

# 通过.dt.days，将"time_gap"列的天数提取出来
df["time_gap"] = df["time_gap"].dt.days


# 输出time_gap这一列
#print(df["time_gap"])

# 2.1 对R进行描述性分析
# 根据time_gap分组聚合，赋值给R
R = df["time_gap"].groupby(df["time_gap"]).count()

# 计算各部分人数，对应的比例
R_percent = R / 51394

# 输出R_percent
#print(R_percent)

# 导入matplotlib.pyplot模块，简写为plt
import matplotlib.pyplot as plt

# 通过给 plt.rcParams["font.sans-serif"] 赋值
# 将字体设置为 Microsoft YaHei 
plt.rcParams["font.sans-serif"] = "Microsoft YaHei"

# TODO 使用plt.bar()函数
# 以R_percent的index为x轴的值，R_percent的values为y轴的值
plt.bar(R_percent.index,R_percent.values)

# 展示图像
plt.show()