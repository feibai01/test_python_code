import pandas as pd 
df = pd.read_csv(r"D:\tools\编程\VSCODE\python_vscode\练习所需文件\user_data\user_data\用户浏览数据.csv")

# TODO 输出df的前5行
#print(df.head())

# 创建一个空列表articles
articles = []

# for循环遍历df['文章类型']
for i in df['文章类型']:  
    
    # 用split()函数将i的数据拆分，并将返回的列表赋值给article
    article = i.split(',')

    # 用append()函数将article添加到空列表articles中
    articles.append(article)
    
    # 输出article
    #print(article)

# 输出articles
#print(articles)

# 导入apyori库中的apriori()函数
from apyori import apriori
# 用apriori()函数进行关联分析，将获取的关联规则赋值给rules
rules = apriori(articles,min_support=0.1,min_confidence=0.6)
# 输出rules
#print(rules)

# 创建空列表，用于存储关联规则等数据
extract_result = []

# for循环遍历rules
for rule in rules:
     #  提取支持度，保留3位小数，并赋值给support
    support = round(rule.support,3)
    # for循环遍历ordered_statistics对象
    for i in rule.ordered_statistics:
        # 获取前件和后件，转为列表后，分别赋值给head_set和tail_set
        head_set = list(i.items_base)
        tail_set = list(i.items_add)
        # 跳过前件为空的数据
        if head_set == []:
            continue
        # 将前件、后件拼接成关联规则的形式
        related_category = str(head_set) + '→' + str(tail_set)
        # 提取置信度，保留3位小数，并赋值给confidence
        confidence = round(i.confidence,3)
        # 提取提升度，保留3位小数，并赋值给lift
        lift = round(i.lift,3)
        # TODO 输出head_set, tail_set, support, confidence, lift
        #print(related_category, support, confidence, lift)
        # 将提取的数据保存到列表extract_result中
        extract_result.append([related_category, support, confidence, lift])
# 将数据转成DataFrame的形式，设置列名为'关联规则', '支持度', '置信度', '提升度'，并赋值给rule_data
rule_data = pd.DataFrame(extract_result, columns=['关联规则', '支持度', '置信度', '提升度'])
# 输出rule_data
#print(rule_data)
# 提取出提升度大于 1 的数据,并赋值给promoted_rules
promoted_rules = rule_data[rule_data['提升度']>1]
# 输出promoted_rules
print(promoted_rules)